# mimis-storefront — environment variable reference
# Copy to .env.local and fill in real values. This file is committed and
# should never contain real secrets.

# --- Supabase ---
# Project: igchqqyassrfpsliyjec (Astrix-Shop). Anon key is public-safe
# (RLS-gated); service role key bypasses RLS and must stay server-only.
NEXT_PUBLIC_SUPABASE_URL=https://igchqqyassrfpsliyjec.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Internal shared secret ---
# Authenticates this app's /api/* routes to the Supabase Edge Functions that
# replace the retired n8n webhooks (X-Mimis-Webhook-Secret header, same
# convention n8n used). Must match the 'loyalty_engine_webhook_secret' row
# in mimis.app_secrets, and the MIMIS_WEBHOOK_SECRET var on mimis-screens.
MIMIS_WEBHOOK_SECRET=

# --- Clover (Madison Heights location; Warren will need its own set once onboarded) ---
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=
CLOVER_WEBHOOK_SIGNING_SECRET=

# --- Supabase Edge Functions this app calls (replacing n8n webhooks) ---
MIMIS_LOYALTY_ENGINE_URL=
MIMIS_DISPATCH_ROUTER_URL=

# --- Google Places (live reviews) ---
# Server-only. Never prefix with NEXT_PUBLIC_ -- that would ship the key to
# every browser. Enable "Places API (New)" on the Google Cloud project and
# restrict the key to that API. Per-location Place IDs are NOT set here; they
# live on mimis.store_locations.google_place_id and are edited in
# Admin -> Storefront Settings. With this unset, review sections render nothing.
GOOGLE_PLACES_API_KEY=

# --- Rollback switch during phased n8n cutover ---
# Remove once every workflow below is confirmed migrated and n8n is retired.
MIMIS_N8N_BASE_URL=https://automation.teamastrixdev.com
